# Diagnostic execution service; retired API/SAST uploads are not served.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS diagnostic-tools
ARG TARGETARCH
ARG HTTPX_VERSION=1.12.0
ARG KATANA_VERSION=1.8.0
ARG NUCLEI_VERSION=3.11.1
COPY lab/offensive/install_tools.py /tmp/install_tools.py
RUN python /tmp/install_tools.py --arch "${TARGETARCH}" --httpx "${HTTPX_VERSION}" --katana "${KATANA_VERSION}" --nuclei "${NUCLEI_VERSION}" && rm /tmp/install_tools.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OFFENSIVE_PORT=8090 OFFENSIVE_DIAGNOSTICS_DIR=/data/offensive/diagnostics \
    HTTPX_BIN=/usr/local/bin/httpx KATANA_BIN=/usr/local/bin/katana NUCLEI_BIN=/usr/local/bin/nuclei
WORKDIR /app
FROM diagnostic-tools AS runtime
COPY lab/offensive/diagnostic_runner.py /app/diagnostic_runner.py
COPY lab/offensive/api_discovery.py /app/api_discovery.py
EXPOSE 8090
CMD ["python", "/app/diagnostic_runner.py"]
